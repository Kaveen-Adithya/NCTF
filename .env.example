PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=nctf
DB_PASSWORD=change-me
DB_NAME=nctf_db

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-random-bytes
FLAG_PEPPER=replace-with-64-random-bytes

# Used only by `npm run seed`. Minimum 12 characters.
ADMIN_PASSWORD=replace-with-a-long-passphrase

# Optional
MAX_TEAM_SIZE=8
